@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@{
    var isUserLoggedIn = HttpContextAccessor.HttpContext.Session.GetString("UsuarioId") != null;
    var userId = 0;
    var userName = string.Empty;
    if(isUserLoggedIn) {
        userId = int.Parse(HttpContextAccessor.HttpContext.Session.GetString("UsuarioId"));
        userName = HttpContextAccessor.HttpContext.Session.GetString("UsuarioNombre");
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Finanzas</title>
    @* Agregados manualmente *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    @* Agregados manualmente *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Finanzas.styles.css" asp-append-version="true" />
</head>
<body id="body">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-secondary border-bottom box-shadow mb-3">
            <div  class="container-fluid">
                <a class="navbar-brand text-light" asp-controller="Home" asp-action="Index">Finanzas</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" id="navMov" style="display:none" asp-area="" asp-controller="Movimiento" asp-action="AgregarMovimiento">Agregar Movimiento</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" id="navMovHist" style="display:none" asp-area="" asp-controller="Movimiento" asp-action="HistorialMovimientos">Historial de Movimientos</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" id="navSign" asp-area="" asp-controller="Usuario" asp-action="SignUp">Registrarse</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" id="navLog" asp-area="" asp-controller="Usuario" asp-action="Login">Iniciar sesion</a>
                        </li>

                        @if (isUserLoggedIn)
                        {
                            <script>
                                document.getElementById("navSign").style.display = "none";
                                document.getElementById("navLog").style.display = "none";
                                document.getElementById("navMov").style.display = "block";
                                document.getElementById("navMovHist").style.display = "block";
                            </script>
                            <div class="dropdown ms-1">
                                <a id="username" class="nav-link dropdown-toggle text-light" role="button" data-bs-toggle="dropdown">@userName</a>
                                    <ul class="dropdown-menu dropdown-menu-end bg-secondary">
                                    <li><a id="DropdownLoginMenu" class="dropdown-item text-light" asp-area="" asp-controller="CuentasPorUsuario" asp-action="AsociarCuenta">Asociar Cuenta</a></li>
                                    <li><a id="DropdownLoginMenu" class="dropdown-item text-light" asp-area="" asp-controller="Usuario" asp-action="Logout">Logout</a></li>
							        </ul>
                            </div>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Finanzas - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
