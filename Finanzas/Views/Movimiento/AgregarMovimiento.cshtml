@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using Newtonsoft.Json
@model Finanzas.Models.Movimiento
@{
    List<SelectListItem> Categoria = (List<SelectListItem>)ViewBag.Categorias;
    List<SelectListItem> Moneda = (List<SelectListItem>)ViewBag.SelectListMoneda;
    List<SelectListItem> CU = (List<SelectListItem>)ViewBag.CU;
    var currencyFormatsJson = JsonConvert.SerializeObject(ViewBag.Monedas);
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/js/currency.js"></script>


<h1> Agregar Movimiento</h1>
<label> Elige con que tipo de moneda vas a operar</label>
<br />
@Html.DropDownList("Moneda", Moneda, "Seleccione la Moneda", new { id = "listMonedas" })


<label> Elige el Nombre </label>
@Html.TextBoxFor(m => m.Nombre, new { @id = "NombreMovimiento", @placeholder = "Ejemplos: Papel Higienico, Compra supermercado, Gasto Hormiga"})

@Html.DropDownList("TipoAccion",
        Html.GetEnumSelectList<TipoAccion>(),
            "Seleccione tipo de movimiento", new { @class = "form-control",@id="TipoMovimiento" })

@Html.DropDownList("Categoria", Categoria, "Seleccione a que categoria pertenece el movimiento", new { @id="Categoria" })

@Html.DropDownList("CU", CU, "Seleccione la cuenta que quieres usar", new { @id = "CUDropdown", @style = "display:none" })


<input id="startDate" class="form-control" type="date"/>

@Html.TextBoxFor(m => m.Monto, new { @id = "Monto", @placeholder = "Monto" })

<input type="button" id="BotonMovimiento" class="btn btn-info" value="Agregar Movimiento" disabled="disabled"/>



<script>
    $(document).ready(function () {
        var rawValue = "";
        const monedaSelect = document.getElementById("listMonedas");
        var valorInput = document.getElementById("Monto");

        const currencyFormats = {};
        const monedas = @Html.Raw(currencyFormatsJson)

            monedas.forEach(moneda => {
                currencyFormats[moneda.Id] = { locale: moneda.Locale, currency: moneda.Nombre };
            });

        console.log(currencyFormats);

        $('#listMonedas').on('change', function () {

            let Moneda = $('#listMonedas').val()
            const formatData = currencyFormats[Moneda] || currencyFormats["ARS"];


            valorInput.addEventListener("input", function () {
                rawValue = this.value.replace(/[^0-9.,]/g, "");
            });

            valorInput.addEventListener("blur", function () {
                const Monedas = monedaSelect.value;
                const numericValue = parseFloat(rawValue.replace(",", ".")) || 0;
                this.value = formatCurrency(numericValue, formatData.locale, formatData.currency);
            });

            valorInput.addEventListener("focus", function () {
                this.value = rawValue;
            });



            let MonedaData = new FormData();

            MonedaData.append("moneda", Moneda);

            $.ajax({
                url: '@Url.Action("BuscarCuentas", "Movimiento")',
                method: "POST",
                data: MonedaData,
                contentType: false,
                processData: false,
                success: function (data) {
                    var CUDropdown = $('#CUDropdown');
                    var datos = "";
                    CUDropdown.empty();
                    $.each(data, function (index, cuenta) {
                        console.log(cuenta);
                        datos += '<option value="' + cuenta.value + '">' + cuenta.text + '</option>';
                    });
                    CUDropdown.append(datos);
                    // Bug aca, añadir validacion por si deselecciona la moneda.
                    console.log(CUDropdown.val())
                    if (CUDropdown.val() != null) {
                        document.getElementById("BotonMovimiento").disabled = false;
                        document.getElementById("CUDropdown").style.display = "inline";
                    } else {
                        document.getElementById("BotonMovimiento").disabled = true;
                        document.getElementById("CUDropdown").style.display = "none";
                    };
                },
                error: function (xhr, status, error) {
                    console.error("Hubo un error: " + error);
                }
            }); //Aca cierra el ajax
        }); //Aca cierra el onchange

        $('#BotonMovimiento').on('click', function () {

            let Moneda = $('#listMonedas').val()
            let NombreMovimiento = $('#NombreMovimiento').val()
            let TipoMovimiento = $('#TipoMovimiento').val()
            let Categoria = $('#Categoria').val()
            let Cuenta = $('#CUDropdown').val()
            let Fecha = $('#startDate').val()
            let Monto = rawValue.trim()

            let MovData = new FormData();

            MovData.append("NombreMovimiento", NombreMovimiento)
            MovData.append("TipoAccion", TipoMovimiento)
            MovData.append("monedaId", Moneda)
            MovData.append("CuentaId", Cuenta)
            MovData.append("fecha", Fecha)
            MovData.append("CategoriaId", Categoria)
            MovData.append("Monto", Monto)

            $.ajax({
                url: '@Url.Action("VincularMovimiento", "Movimiento")',
                method: 'POST',
                data: MovData,
                contentType: false,
                processData: false,
                success: function (data) {
                    window.location.href = '@Url.Action("Index", "Home")';
                }
            });//Aca cierra el ajax de agregarmovimiento

            const formatData = currencyFormats[Moneda] || currencyFormats["ARS"];


            valorInput.addEventListener("input", function () {
                rawValue = this.value.replace(/[^0-9.,]/g, "");
            });

            valorInput.addEventListener("blur", function () {
                const Monedas = monedaSelect.value;
                const numericValue = parseFloat(rawValue.replace(",", ".")) || 0;
                this.value = formatCurrency(numericValue, formatData.locale, formatData.currency);
            });

            valorInput.addEventListener("focus", function () {
                this.value = rawValue;
            });

        }); //Aca cierra el agregarMovimiento
        });

</script>


