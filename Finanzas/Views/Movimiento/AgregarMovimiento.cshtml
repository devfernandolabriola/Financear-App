@using Newtonsoft.Json
@model Finanzas.Models.Movimiento
@{
    List<SelectListItem> Categoria = (List<SelectListItem>)ViewBag.Categorias;
    List<SelectListItem> CU = (List<SelectListItem>)ViewBag.CU;

}

<h1> Agregar Movimiento</h1>
<label> Elige el Nombre </label>
@Html.TextBoxFor(m => m.Nombre, new { @id = "NombreMovimiento", @placeholder = "Ejemplos: Papel Higienico, Compra supermercado, Gasto Hormiga" });

@Html.DropDownList("TipoAccion",
        Html.GetEnumSelectList<TipoAccion>(),
        "Seleccione tipo de movimiento", new { @class = "form-control" })

@Html.DropDownList("Categoria", Categoria, "Seleccione a que categoria pertenece el movimiento")

@Html.DropDownList("CuentaPorUsuario", CU, "Seleccione la cuenta")