@{
	var monedas = ViewBag.Monedas;
	var movimientosUsuario = ViewBag.listMovimientos;
	var listMovimientos = movimientosUsuario;
	var movimientoMoneda = ViewBag.MonedaAgregada;
}
<script src="/js/currency.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
	#movimientos {
		font-family: Arial, Helvetica, sans-serif;
		border-collapse: collapse;
		width: 100%;
	}

		#movimientos td, #movimientos th {
			border: 1px solid #ddd;
			padding: 8px;
		}

		#movimientos tr:nth-child(odd) {
			background-color: rgb();
		}

		#movimientos tr:nth-child(even) {
			background-color: blue;
		}

		#movimientos tr:hover {
			background-color: rgb(120 120 120);
		}

		#movimientos th {
			padding-top: 12px;
			padding-bottom: 12px;
			text-align: left;
			background-color: #04AA6D;
			color: white;
		}
</style>
@foreach (var moneda in monedas)
{
	<h2 value="@moneda.Id">@moneda.Nombre</h2>
	<table id="movimientos">
		<thead>
			<tr>
				<th>Nombre</th>
				<th>Tipo de movimiento</th>
				<th>Fecha</th>
				<th>Categoria</th>
				<th>Cuenta</th>
				<th>Monto</th>
				<th>Total Actualizado</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var movimiento in movimientoMoneda)
			{
				if (moneda.Id == movimiento.Moneda.Id)
				{
					<tr>
						<td>@movimiento.Nombre</td>
						@if(movimiento.TipoAccion == TipoAccion.GASTO) {
							<td style="background-color: #F4C7C3; color:red;">@Enum.GetName(typeof(TipoAccion), movimiento.TipoAccion)</td>
						}
						@if (movimiento.TipoAccion == TipoAccion.INGRESO)
						{
							<td style="background-color: #B7E1CD; color:green;">@Enum.GetName(typeof(TipoAccion), movimiento.TipoAccion)</td>
						}
						@if (movimiento.TipoAccion == TipoAccion.TRANSFERENCIA)
						{
							<td style="background-color: darkgrey;">@Enum.GetName(typeof(TipoAccion), movimiento.TipoAccion)</td>
						}
						<td>@movimiento.Fecha</td>
						<td>@movimiento.Categoria</td>
						<td>@movimiento.Cuenta</td>

						<td id="moneda-@movimiento.Id">
							<script>
								var monto = @movimiento.Monto;
								var locale = '@movimiento.Moneda.Locale';
								var nombre = '@movimiento.Moneda.Nombre';
								var montoFormat = formatCurrency(monto, locale, nombre);
								console.log(montoFormat)
								document.getElementById('moneda-@movimiento.Id').innerHTML = montoFormat
							</script>

						</td>
						<td id="valorAct-@movimiento.Id">
							<script>
								var valorAct = @movimiento.ValorTotalActual;
								var valorActFormat = formatCurrency(valorAct, locale, nombre);
								document.getElementById('valorAct-@movimiento.Id').innerHTML = valorActFormat
							</script>

						</td>
						<td style="background-color:red;">
							<button style="color: white; background: transparent; border: none;" @* onclick="EliminarMovimiento(@movimiento.Id,'@movimiento.Nombre')" *@ data-nombre="@movimiento.Nombre" data-id="@movimiento.Id" class="BotonModal">
								<i class="bi bi-trash3"></i>
							</button>

							<script>
								$('document').ready(function () {

								

									$('.BotonModal').on('click', function () {
										var nombre = $(this).data('nombre');
										var MovimientoId = $(this).data('id');
										$('#ModalNombreMovimiento').text(nombre);
										$('#ModalMovimientoId').text(MovimientoId);
										$('#EliminarMovimientoModal').modal('show');
									});


									$('#CloseModal').on('click', function () {
										$('#EliminarMovimientoModal').modal('hide');
									});

									$('#CerrarModal').on('click', function () {
										$('#EliminarMovimientoModal').modal('hide');
									});
								});

								$('#BotonEliminar').on('click', function () {

									let movimientoId = $('#ModalMovimientoId').text();
									console.log(movimientoId);
									EliminarMovimiento(movimientoId);

								}); 

								function EliminarMovimiento(movimientoId) {
									

									let formData = new FormData();

									formData.append("MovimientoId", movimientoId)



									$.ajax({
										url: '@Url.Action("EliminarMovimiento", "Movimiento")',
										method: "Post",
										data: formData,
										contentType: false,
										processData: false,
										success: function (data) {
											window.location.href = '@Url.Action("HistorialMovimientos", "Movimiento")';
										}
									});
								}

							</script>
						</td>

					</tr>
					<!-- Modal -->
					<div class="modal fade" id="EliminarMovimientoModal" tabindex="-1" role="dialog" aria-labelledby="EliminarMovimientoModalTitle" aria-hidden="true">
						<div class="modal-dialog modal-dialog-centered" role="document">
							<div class="modal-content  bg-black">
								<div class="modal-header">
									<h5 class="modal-title text text-danger" id="exampleModalLongTitle">Eliminar Movimiento</h5>
									<button type="button" style="background-color:transparent; color:white;" class="close" id="CloseModal" data-dismiss="modal" aria-label="Close">
										<span aria-hidden="true">&times;</span>
									</button>
								</div>
								<div class="modal-body">
									<div>
									<p style="justify-content:center; display:inline;"> ¿Esta seguro que desea eliminar el movimiento </p>
									<p style="display:inline;" id="ModalNombreMovimiento"></p>
									<p style="display:inline;" >?</p>
									<p id="ModalMovimientoId" style="display:none;"></p>
									</div>
								</div>
								<div class="modal-footer">
									<button type="button" class="btn btn-secondary" id="CerrarModal" data-dismiss="modal">Cancelar</button>
									<button type="button" id="BotonEliminar" class="btn btn-danger">Eliminar</button>
								</div>
							</div>
						</div>
					</div>
					<!-- Modal -->
					<script>

					</script>
				}
			}
	
		</tbody>
	</table>
}

