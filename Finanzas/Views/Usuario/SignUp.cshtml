@{
    
}

@using (Html.BeginForm("SignUp", "Usuario", FormMethod.Post)) {
    @Html.Label("Mail")
    @Html.TextBoxFor(u => u.Email)
    @Html.Label("Nombre")
    @Html.TextBoxFor(u => u.Nombre)
    @Html.Label("Clave")
    @Html.PasswordFor(u => u.Clave)

}