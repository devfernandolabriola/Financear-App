@model Finanzas.DTO.UsuarioDTO

@Html.TextBoxFor(u => u.Email, new { @id = "Email", @placeholder = "Email" })
@Html.TextBoxFor(u => u.Nombre, new { @id = "Nombre", @placeholder = "Nombre" })
@Html.PasswordFor(u => u.Clave, new { @id = "Clave", @placeholder = "Clave", @minLength = "8" })
<p id="UsuarioMailExisten" style="color: red; display:none;">El correo o usuario ya existen.</p>
<p id="CompletarDatos" style="color: red; display:none;">Todos los datos tienen que tener algun valor.</p>
<input type="button" onclick="register()" name="SignUpButton" id="SignUpButton" value="SignUp" />
<script>


    function register() {
        let email = $('#Email').val();
        let nombre = $('#Nombre').val();
        let clave = $('#Clave').val();
        let emailLimpio = email.replaceAll(' ', '');
		let nombreLimpio = nombre.replaceAll(' ', '');
		let claveLimpio = clave.replaceAll(' ', '');
        if(emailLimpio == "" || nombreLimpio == "" || claveLimpio == ""){
            document.getElementById("CompletarDatos").style.display = "inline";
			return;
		}

        $.ajax({
            url: '@Url.Action("Register", "Usuario")',
            method: "POST",
            data: JSON.stringify({ Email: emailLimpio, Nombre: nombreLimpio, Clave: claveLimpio }),
            contentType: "application/json",
            dataType: "json",
            success: function (data) {
         
                window.location.href = '@Url.Action("Index", "Home")';
            },
            error: function (xhr,s,p) {
                document.getElementById("UsuarioMailExisten").style.display = "inline";
            }
        });
    };
</script>