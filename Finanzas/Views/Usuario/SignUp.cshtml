@model Finanzas.Models.Usuario

@Html.TextBoxFor(u => u.Email, new { @id = "Email", @placeholder = "Email" })
@Html.TextBoxFor(u => u.Nombre, new { @id = "Nombre", @placeholder = "Nombre" })
@Html.PasswordFor(u => u.Clave, new { @id = "Clave", @placeholder = "Clave", @minLength = "8" })
<p id="MensajeError" style="color: red; display:none;">El Correo o nombre ya existe, fijate capo</p>

<input type="button" onclick="register()" name="SignUpButton" id="SignUpButton" value="SignUp" />

<script>


    function register() {
        let email = $('#Email').val();
        let nombre = $('#Nombre').val();
        let clave = $('#Clave').val();
        console.log(email);

        $.ajax({
            url: '@Url.Action("Register", "Usuario")',
            method: "POST",
            data: JSON.stringify({ Email: email, Nombre: nombre, Clave: clave }),
            contentType: "application/json",
            dataType: "json",
            error: function (xhr,s,p) {
                console.log("entre por el amor de dios");
                console.log(xhr, s, p);
                document.getElementById("MensajeError").style.display = "inline";
            }
        });
    };
</script>