@model Finanzas.DTO.UsuarioDTO
<div id="Register">
    <br />
<div class="input-group" id="Tbx">
    <div class="input-group-prepend">
        <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
    </div>
         @Html.TextBoxFor(u => u.Email, new { @id = "Email", @placeholder = "Email", type = "email", @Class = "TextSign", @TextMode = "Email" }) 
@*         @Html.TextBox("Email", Model.Email, new { @type = "email", @class = "TextSign", @id = "Email", @placeholder = "Email" }) *@
    </div>
<div class="input-group" id="Tbx">
    <div class="input-group-prepend">
        <span class="input-group-text"><i class="bi bi-person"></i></span>
    </div>
    @Html.TextBoxFor(u => u.Nombre, new { @id = "Nombre", @placeholder = "Nombre", @Class = "TextSign" })
</div>
<div class="input-group" id="Tbx">
    <div class="input-group-prepend">
        <span class="input-group-text"><i class="bi bi-key"></i></span>
    </div>
    @Html.PasswordFor(u => u.Clave, new { @id = "Clave", @placeholder = "Clave", @minLength = "8", @Class = "TextSign" })
</div>
<div id="SignUpButton">
  
<p id="MensajeError" style="color: red; display:none; padding:17px;">Todos los datos tienen que tener algun valor.</p>
        <div style="padding:17px;">
            <input type="button" class="btn btn-success" onclick="register()" name="SignUpButton" id="SignUpButton" value="Registrarse" />
        </div>
</div>
</div>
<script type="text/javascript">
    document.getElementById("Email").type = "email";

    function register() {
        let email = $('#Email').val();
        let nombre = $('#Nombre').val();
        let clave = $('#Clave').val();
        let emailLimpio = email.replaceAll(' ', '');
		let nombreLimpio = nombre.replaceAll(' ', '');
		let claveLimpio = clave.replaceAll(' ', '');

        let cantClave = claveLimpio.length;
        if (cantClave < 8) {
            document.getElementById("MensajeError").innerText = "La clave debe tener mas de 8 caracteres"
            document.getElementById("MensajeError").style.display = "inline";
            return;
        }

        if (emailLimpio == "" || nombreLimpio == "" || claveLimpio == "") {
            document.getElementById("MensajeError").innerText = "Todos los campos deben tener un valor"
            document.getElementById("MensajeError").style.display = "inline";
            return;
        }

        $.ajax({
            url: '@Url.Action("Register", "Usuario")',
            method: "POST",
            data: JSON.stringify({ Email: emailLimpio, Nombre: nombreLimpio, Clave: claveLimpio }),
            contentType: "application/json",
            dataType: "json",
            success: function (data) {
         
                window.location.href = '@Url.Action("Index", "Home")';
            },
            error: function (xhr,s,p) {
                document.getElementById("MensajeError").innerText = "El correo ya existe o es invalido"
                document.getElementById("MensajeError").style.display = "inline"
            }
        });
    };


</script>