@{
}

@* Letras en blanco y acciones en color  *@


@model Finanzas.DTO.UsuarioLoginDTO
<div id="Login">
    <br />
<div class="input-group" id="Tbx">
    <div class="input-group-prepend">
        <span class="input-group-text"><i class="bi bi-person"></i></span>
    </div>
    @Html.TextBoxFor(u => u.Nombre, new { @id = "Nombre", @placeholder = "Nombre", @Class = "LoginView" })
</div>
<div class="input-group" id="Tbx">
    <div class="input-group-prepend">
        <span class="input-group-text"><i class="bi bi-key"></i></span>
    </div>
    @Html.PasswordFor(u => u.Clave, new { @id = "Clave", @placeholder = "Clave", @minLength = "8", @Class = "LoginView" })
</div>
    <div id="LoginButton">
<p id="MensajeError" style="color: red; display:none; padding:17px;" class="LoginView">Nombre de usuario o clave incorrectos.</p>

    <div  style="padding:17px;">
        <input type="button" onclick="login()" class="btn btn-warning" name="LogInButton" id="LogInButton" value="Iniciar Sesión" />
    </div>
 </div>
</div>
<script>


    function login() {
        let nombre = $('#Nombre').val();
        let clave = $('#Clave').val();

        $.ajax({
            url: '@Url.Action("IniciarSesion", "Usuario")',
            method: "POST",
            data: JSON.stringify({ Nombre: nombre, Clave: clave }),
            contentType: "application/json",
            dataType: "json",
            success: function (data) {

                window.location.href = '@Url.Action("Index", "Home")';
            },
            error: function (xhr,s,p) {
                document.getElementById("MensajeError").style.display = "inline";
            }
        });
    };
</script>