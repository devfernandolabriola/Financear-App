@{
    List<SelectListItem> cuentas = (List<SelectListItem>)ViewBag.Cuentas;
    @if (cuentas.Count > 0) {
    <div class="Dropdown">
        @Html.DropDownList("cuentas",cuentas, "Selecciona que cuenta bancaria tienes", new{@class="form-method"})
        </div>
    }
    else
    {
        <a> no se cargan los datos </a>
    }

}
