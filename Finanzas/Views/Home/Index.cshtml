@{
	ViewData["Title"] = "Home Page";

}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/js/currency.js"></script>
<script src="/js/graph.js"></script>
<style>
	.hidden-content {
		visibility: hidden;
	}
	body {
		height: 100% !important;
		overflow-y: scroll !important; 
		
	}
</style>
@if (ViewBag.IsUserLoggedIn != null && ViewBag.IsUserLoggedIn) {
	if (ViewBag.TieneCuentas) {
		<div id="chartsContainer" class="hidden-content" style="width: 30%; margin: auto;"></div>

		<script>
                // Datos desde el servidor
                const data = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MontosPorMoneda));
                const monedas = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.NombreMonedas));
                const montoTotalXMoneda = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.MontoTotalXMoneda));
				generarGrafico(data,monedas,montoTotalXMoneda);

				document.addEventListener("DOMContentLoaded", function() {
					document.getElementById('chartsContainer').classList.remove('hidden-content');
				});
        </script>


	} else {
		<div class="text-center">
			<h1 class="display-4">No tienes cuentas asociadas.</h1>
            <p> Puedes Asociar una cuenta haciendo <a asp-area="" asp-controller="CuentasPorUsuario" asp-action="AsociarCuenta"> click aqui</a>.</p>
		</div>
	}

} else {
	<div class="text-center">
		<h1 class="display-4">Welcome</h1>
		<p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
	</div>
}