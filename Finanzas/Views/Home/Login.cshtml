@model Finanzas.Models.Usuario


@using (Html.BeginForm("Login","UsuarioController",FormMethod.Get))
{
    @Html.Label("Ingrese Correo")
    @Html.TextBoxFor(Usuario => Usuario.Email)

    @Html.Label("Ingrese Contraseña")
    @Html.TextBoxFor(Usuario => Usuario.Clave)
    <input type="submit" />
}
