@model Finanzas.Models.Usuario

@using(Html.BeginForm("Login","UsuarioController", FormMethod.Get)) {
    @Html.Label("Ingresa tu correo inmundo")
    @Html.TextBoxFor(user => user.Email)
    @Html.Label("Ingrese clave, asqueroso")
    @Html.TextBoxFor(user => user.Clave)
    <input type="submit" value="Ingresar"/>
}